  "narrative": {
    "northStar": "The Contextual Workspace",
    "overview": "BuildHub adapts the user-pinned RonDesignLab Customer Journey CRM reference into an application-wide operational workspace. A slim icon rail identifies global sections; horizontal pills expose their contextual destinations. Cool blue-gray canvas, near-white surfaces, dark ink, periwinkle accents and restrained coral feedback establish the shared visual language.\n\nThis record replaces the former scoped warm copper identity. The direction contract is [DIRECTION.md](docs/redesign/DIRECTION.md). Palette values are approximate adaptations from supplied raster references, not original Figma tokens. Existing BuildHub branding, customer palette controls and bilingual local fonts remain authoritative.",
    "keyCharacteristics": [
      "Separate global selection from contextual navigation.",
      "Use rounded modular surfaces with tonal depth.",
      "Keep operational records, forms and tables readable in English and Arabic.",
      "Use short state feedback and respect reduced motion."
    ],
    "rules": [
      {
        "name": "The Palette Ownership Rule",
        "body": "Keep customer branding variables configurable; use workspace semantic tokens for shared surfaces, text, focus and status feedback.",
        "section": "colors"
      },
      {
        "name": "The Tonal Surface Rule",
        "body": "Group persistent working content with surface tone and spacing; reserve the shared elevation tokens for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic workspace tokens and existing shared controls for new surfaces.",
      "Do preserve saved customer palettes, BuildHub branding and the local bilingual fonts.",
      "Do keep translated labels, logical spacing, visible focus and reduced-motion behavior.",
      "Do connect navigation, summaries and schedules to their existing routes and real data owners.",
      "Do inspect final matching declarations when a legacy module overrides a shared primitive."
    ],
    "donts": [
      "Don't restore the obsolete scoped copper identity as the application default.",
      "Don't promote one page composition into a mandatory layout for every module.",
      "Don't invent customer records, metrics, dependencies or approval states to fill a visual.",
      "Don't describe fixture screenshots or source inspection as full live acceptance."
    ]
  }
